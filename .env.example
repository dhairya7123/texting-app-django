# Django Backend Settings
DEBUG=True
SECRET_KEY=django-insecure-texting-app-development-key-9db32b65-2aa4-4ef4-9d55
ALLOWED_HOSTS=*

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=texting_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Set to True if running tests locally without a running PostgreSQL instance:
USE_SQLITE=False

# Redis Configuration for Django Channels
REDIS_URL=redis://127.0.0.1:6379/1
# Set to True if running tests locally without a running Redis instance:
USE_INMEMORY_CHANNELS=False

# JWT Lifetime Settings
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
